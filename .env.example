# SignMate Web Configuration
# IMPORTANT: Never commit actual API keys or secrets to git.

# Application
VITE_APP_NAME=SignMate
VITE_APP_TAGLINE="AI-Assisted Inclusive Communication"
VITE_APP_ENV=development

# Firebase (Client SDK Config - Future Phase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com

# ZEGOCLOUD (Video Conferencing - Future Phase)
# NOTE: ServerSecret must NEVER be in frontend source code. Token generation happens via backend.
VITE_ZEGO_APP_ID=

# FastAPI Inference Server (SignMate_MobileNetV3Small - Future Phase)
VITE_AI_API_BASE_URL=http://localhost:8000

# Backend Gemini Suggestions Service (Proxy URL - Future Phase)
# NOTE: Gemini API key must remain strictly on the backend server.
VITE_GEMINI_PROXY_URL=http://localhost:8000/api/gemini/suggest
