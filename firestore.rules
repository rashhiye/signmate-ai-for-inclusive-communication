rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms and participants for video conferencing
    match /rooms/{roomId} {
      allow read, write: if true;

      match /participants/{participantId} {
        allow read, write: if true;
      }

      match /callerCandidates/{candidateId} {
        allow read, write: if true;
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if true;
      }
    }

    // User profiles and directory
    match /users/{userId} {
      allow read, write: if true;
    }

    // Social connection requests
    match /requests/{requestId} {
      allow read, write: if true;
    }

    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    // Complaints and Grievances
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Feedbacks
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Global collection access for development & production
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
